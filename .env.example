# LUMINA (RaaOS Engine) — Environment Variables
# Copy this file to .env.local for local development.

# -----------------------------------------------------------------------------
# 1. Google Gemini AI Engine
# -----------------------------------------------------------------------------
# Required for live AI Companion chat and Sanctuary Reflection synthesis.
# If omitted or invalid, LUMINA automatically falls back to honest Local-Only mode.
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# 2. PostgreSQL Database & Prisma ORM (Milestone 17C / 17D)
# -----------------------------------------------------------------------------
# Primary PostgreSQL connection string with connection pooling (e.g., Supabase / Neon / Railway).
# If omitted, LUMINA operates seamlessly in Local-First mode using browser/app IndexedDB.
DATABASE_URL="postgresql://postgres:password@localhost:5432/lumina_sanctuary?schema=public&sslmode=prefer"

# Direct PostgreSQL connection string without pooler (used for Prisma migrations).
# Optional: defaults to DATABASE_URL if not provided.
DIRECT_URL="postgresql://postgres:password@localhost:5432/lumina_sanctuary?schema=public&sslmode=prefer"

# -----------------------------------------------------------------------------
# 3. Security & Cryptographic Secrets
# -----------------------------------------------------------------------------
# 32+ character random secret used for session token signing and tamper verification.
SESSION_SECRET="generate_a_random_32_byte_secret_key_for_lumina_sessions"

# -----------------------------------------------------------------------------
# 4. Mobile & Capacitor Android Configuration
# -----------------------------------------------------------------------------
# Optional: Base URL for API requests when running inside a native Android APK
# via Capacitor (e.g., https://lumina.yourdomain.com). On web, leaves empty for relative /api routes.
NEXT_PUBLIC_API_BASE_URL=
